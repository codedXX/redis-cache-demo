<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rediscache.mapper.ProductMapper">

    <resultMap id="ProductResultMap" type="com.example.rediscache.pojo.Product">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="price" column="price" />
    </resultMap>

    <select id="selectById" parameterType="long" resultMap="ProductResultMap">
        SELECT id, name, price
        FROM products
        WHERE id = #{id}
    </select>

    <select id="selectAllIds" resultType="long">
        SELECT id
        FROM products
        ORDER BY id
    </select>
</mapper>
